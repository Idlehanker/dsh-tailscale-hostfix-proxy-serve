{
  "name": "dsh-tailscale-hostfix-proxy-serve",
  "version": "1.0.0",
  "description": "Serve a loopback-only app behind tailscale serve (or Caddy/nginx). Rewrites Host and Origin so servers that 403 any non-loopback Host stop breaking when reached over a tailnet URL.",
  "type": "module",
  "license": "MIT",
  "author": "Idlehanker",
  "keywords": [
    "tailscale",
    "tailscale-serve",
    "reverse-proxy",
    "host-header",
    "dns-rebinding",
    "loopback",
    "403",
    "dsh-plugin",
    "deepseek-harness"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "dsh-tailscale-hostfix-proxy-serve": "./bin/cli.js"
  },
  "exports": {
    ".": "./src/proxy.js"
  },
  "files": [
    "src",
    "bin",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "node --check src/proxy.js && node --check bin/cli.js && node --test test/*.test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Idlehanker/dsh-tailscale-hostfix-proxy-serve.git"
  },
  "homepage": "https://github.com/Idlehanker/dsh-tailscale-hostfix-proxy-serve#readme",
  "bugs": {
    "url": "https://github.com/Idlehanker/dsh-tailscale-hostfix-proxy-serve/issues"
  }
}
